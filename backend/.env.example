SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUSH_WEBHOOK_SECRET=
PORT=4000

# Flutter 클라이언트(FCM 네이티브 토큰)로 푸시를 보낼 때만 필요하다. RN(Expo)만 쓰는
# 로컬 개발 중에는 비워둬도 된다 — sendFcmPushNotifications가 실제로 호출될 때만
# 에러를 던지므로 앱 전체가 크래시하지 않는다.
# 발급: Firebase Console → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"으로
# 받은 JSON 파일 전체 내용을 (줄바꿈 없이) 한 줄 문자열로 저장한다.
FIREBASE_SERVICE_ACCOUNT_KEY=
# 운영 배포 시 실제 프론트엔드 도메인으로 좁힐 것 (쉼표로 여러 개 가능, 예:
# https://app.familytoktok.com,https://familytoktok.com).
# 로컬 개발 중에는 비워두면 app.ts의 기본값(전체 허용)이 적용된다 — 네이티브
# 앱(iOS/Android)은 브라우저가 아니라 CORS 제약을 받지 않으므로 이 값은
# Expo 웹 개발 서버 등 브라우저 기반 호출에만 영향을 준다.
CORS_ORIGIN=
